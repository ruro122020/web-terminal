# The gatekeeper: listens on the Tailscale address and lets only the iPhone through.
# systemd/install.sh in the project folder fills the project's path into this file and installs the
# result in ~/.config/systemd/user. Edit the copy in the project and run install.sh again.
[Unit]
Description=web-terminal: iPhone-only gatekeeper
Wants=web-terminal-ttyd.service
After=web-terminal-ttyd.service
# At boot the Tailscale address may not exist yet, so keep retrying instead of giving up.
StartLimitIntervalSec=0

[Service]
WorkingDirectory=@PROJECT_DIR@
# Must match the socket ttyd creates in web-terminal-ttyd.service.
Environment=TTYD_SOCKET=%t/web-terminal/ttyd.sock
# The Bitwarden access token lives outside the repo, in a file only you can read.
EnvironmentFile=%h/.config/web-terminal/bws.env
# bws fetches the addresses from Bitwarden Secrets Manager and hands them to the gatekeeper as
# environment variables. The gatekeeper is built with `npm run build` (see the README).
ExecStart=%h/.local/bin/bws run -- @PROJECT_DIR@/gatekeeper/target/release/gatekeeper
Restart=always
RestartSec=5
# Exit code 78 means a setting is missing or wrong. Retrying cannot fix that, so stop
# instead of calling Bitwarden every few seconds; `journalctl --user -u web-terminal` says why.
RestartPreventExitStatus=78

# Sandboxing: limits on what the gatekeeper can do if it ever misbehaves.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Neither bws nor the gatekeeper generates machine code while running, so memory that is
# both writable and executable can be forbidden.
MemoryDenyWriteExecute=yes
UMask=0077
TasksMax=64
MemoryMax=512M

[Install]
WantedBy=default.target
