{
  "name": "web-terminal",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cargo build --release --manifest-path gatekeeper/Cargo.toml",
    "test": "node --test --test-timeout=20000 test/*.test.mjs",
    "test:gatekeeper": "cargo test --manifest-path gatekeeper/Cargo.toml",
    "test:system": "npm run build && node --test --test-timeout=60000 test/system/*.test.mjs",
    "test:browser": "npm run build && node --test --test-timeout=120000 test/browser/*.test.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
